# %% [markdown]
# Opera Cloud schema export for Maulik
# Field list = RA Models.xlsx (TablesAndFields sheet, 224 fields)
#            + ALLOTMENT_HEADER and STAY_RECORDS pulled from the OperaCloud DW.
# Adds SQL data types from the DW, a check that each field exists in the DW,
# and table/field descriptions. Run cell by cell; review before exporting.

# %% Cell 1 - Config and connection
import pandas as pd
from sqlalchemy import create_engine
from urllib.parse import quote_plus

EXCEL_PATH = r"RA Models.xlsx"          # <- full path if not in the notebook folder
SHEET_NAME = "TablesAndFields"

SERVER = "DWDatabase"                   # <- confirm server name
DATABASE = "OperaCloud"
DRIVER = "ODBC Driver 17 for SQL Server"

ADDITIONAL_TABLES = ["ALLOTMENT_HEADER", "STAY_RECORDS"]

# Excel names that differ from the DW table/column names
TABLE_NAME_MAP = {"AR$_ACCOUNT": "AR_ACCOUNT"}
FIELD_NAME_MAP = {"ID (used to be ROWID)": "ID"}

# Also list DW columns that are not in the Excel model (for the in-scope tables)?
INCLUDE_DW_ONLY_COLUMNS = False

conn_str = (
    f"DRIVER={{{DRIVER}}};SERVER={SERVER};DATABASE={DATABASE};"
    "Trusted_Connection=yes;TrustServerCertificate=yes;"
)
engine = create_engine(f"mssql+pyodbc:///?odbc_connect={quote_plus(conn_str)}")
print("Configured:", SERVER, "/", DATABASE)

# %% Cell 2 - Read the Excel field list
xl = pd.read_excel(EXCEL_PATH, sheet_name=SHEET_NAME, usecols="A:D", dtype=str)
xl.columns = ["ExcelTableName", "ExcelFieldName", "PK", "InExport"]
xl = xl.dropna(subset=["ExcelTableName", "ExcelFieldName"])
xl = xl.apply(lambda s: s.str.strip())
xl[["PK", "InExport"]] = xl[["PK", "InExport"]].fillna("")

xl["TableName"] = xl["ExcelTableName"].replace(TABLE_NAME_MAP)
xl["FieldName"] = xl["ExcelFieldName"].replace(FIELD_NAME_MAP)
xl["Source"] = "RA Models.xlsx"
xl["ExcelOrder"] = range(len(xl))

print(len(xl), "fields from Excel (expected 224)")
xl.groupby("TableName").size()

# %% Cell 3 - DW columns and data types
schema_sql = """
SELECT
    c.TABLE_NAME               AS TableName,
    c.COLUMN_NAME              AS FieldName,
    c.ORDINAL_POSITION         AS DWOrder,
    c.DATA_TYPE                AS DataType,
    c.CHARACTER_MAXIMUM_LENGTH AS MaxLength,
    c.NUMERIC_PRECISION        AS NumericPrecision,
    c.NUMERIC_SCALE            AS NumericScale,
    c.IS_NULLABLE              AS IsNullable
FROM INFORMATION_SCHEMA.COLUMNS c
JOIN INFORMATION_SCHEMA.TABLES t
  ON t.TABLE_SCHEMA = c.TABLE_SCHEMA
 AND t.TABLE_NAME   = c.TABLE_NAME
 AND t.TABLE_TYPE   = 'BASE TABLE'
WHERE c.TABLE_SCHEMA = 'dbo';
"""
dw = pd.read_sql(schema_sql, engine)


def format_type(row):
    dt = row["DataType"]
    if dt in ("varchar", "nvarchar", "char", "nchar", "varbinary", "binary"):
        n = row["MaxLength"]
        if pd.isna(n):
            return dt
        return f"{dt}(max)" if int(n) == -1 else f"{dt}({int(n)})"
    if dt in ("decimal", "numeric"):
        return f"{dt}({int(row['NumericPrecision'])},{int(row['NumericScale'])})"
    return dt


dw["SQLDataType"] = dw.apply(format_type, axis=1)
dw["TableKey"] = dw["TableName"].str.upper()
dw["FieldKey"] = dw["FieldName"].str.upper()
print(len(dw), "DW columns across", dw["TableName"].nunique(), "tables")

# %% Cell 4 - Add ALLOTMENT_HEADER and STAY_RECORDS from the DW
extra = dw[dw["TableKey"].isin([t.upper() for t in ADDITIONAL_TABLES])].copy()
extra = extra.sort_values(["TableName", "DWOrder"])
extra["TableName"] = extra["TableKey"]
extra["PK"] = extra["FieldKey"].eq("PKID").map({True: "Y", False: ""})
extra["InExport"] = "Y"
extra["Source"] = "OperaCloud DW"
extra["ExcelOrder"] = range(len(xl), len(xl) + len(extra))
extra = extra[["TableName", "FieldName", "PK", "InExport", "Source", "ExcelOrder"]]

print(extra.groupby("TableName").size())   # expect ALLOTMENT_HEADER 17, STAY_RECORDS 27

fields = pd.concat(
    [xl[["TableName", "FieldName", "PK", "InExport", "Source", "ExcelOrder"]], extra],
    ignore_index=True,
)

# Optional: DW columns of in-scope tables that the Excel model doesn't list
if INCLUDE_DW_ONLY_COLUMNS:
    in_scope = set(fields["TableName"].str.upper())
    known = set(zip(fields["TableName"].str.upper(), fields["FieldName"].str.upper()))
    dw_only = dw[dw["TableKey"].isin(in_scope)]
    dw_only = dw_only[[(t, f) not in known for t, f in zip(dw_only["TableKey"], dw_only["FieldKey"])]]
    dw_only = dw_only.assign(
        TableName=dw_only["TableKey"], PK="", InExport="", Source="OperaCloud DW (not in model)",
        ExcelOrder=range(len(fields), len(fields) + len(dw_only)),
    )[["TableName", "FieldName", "PK", "InExport", "Source", "ExcelOrder"]]
    fields = pd.concat([fields, dw_only], ignore_index=True)

print(len(fields), "fields in total (expected 268 = 224 + 17 + 27)")

# %% Cell 5 - Join data types and flag anything missing from the DW
fields["TableKey"] = fields["TableName"].str.upper()
fields["FieldKey"] = fields["FieldName"].str.upper()
merged = fields.merge(
    dw[["TableKey", "FieldKey", "SQLDataType", "IsNullable"]],
    on=["TableKey", "FieldKey"], how="left",
)
merged["InDW"] = merged["SQLDataType"].notna().map({True: "Y", False: "N"})
merged["SQLDataType"] = merged["SQLDataType"].fillna("")
merged["IsNullable"] = merged["IsNullable"].fillna("")

not_in_dw = merged[merged["InDW"] == "N"]
print(len(not_in_dw), "fields not found in the OperaCloud DW:")
not_in_dw[["TableName", "FieldName", "InExport"]]

